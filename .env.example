# Copy to .env (gitignored) and uncomment to override defaults.
# Every field in config.py Settings is overridable here or via the container env.

# --- LLM (llama.cpp llama-server on the Jetson host) ---
# LLAMACPP_URL=http://host.docker.internal:8080/completion
# LLAMACPP_N_PREDICT=256
# LLAMACPP_TEMPERATURE=0.2
# LLAMACPP_READ_TIMEOUT=300

# --- Embeddings ---
# EMBEDDING_MODEL=intfloat/multilingual-e5-large
# EMBEDDING_BATCH_SIZE=32          # lower (e.g. 8) on a 4 GB Orin Nano

# --- Retrieval ---
# TOP_K=10
# RRF_K=60
# CHUNK_SIZE=800
# CHUNK_OVERLAP=200

# --- API ---
# API_TOKEN=change-me              # require X-API-Token on POST /download

# --- Downloader ---
# MAVAT_REQUEST_TIMEOUT=60
# MAVAT_INSECURE_SSL=0             # 1 disables TLS verification (last resort)
